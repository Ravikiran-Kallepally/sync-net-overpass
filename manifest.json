{
  "manifest_version": 3,
  "name": "Sync-Net Overpass",
  "version": "1.1",
  "description": "Syncs code and errors across devices on the same google account.",
  "permissions": ["storage", "contextMenus", "clipboardWrite"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  }
}